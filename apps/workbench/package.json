    "uuid": "11.1.1",
    "argparse": "2.0.1"
  },
  "devDependencies": {
    "@electron/osx-sign": "2.7.1",
    "echarts": "^6.1.0",
    "esbuild": "^0.28.2",
    "mermaid": "^12.1.0"
  }
}
