{
  "schemaVersion": 1,
  "id": "input.web",
  "name": "联网取材",
  "version": "1.3.0",
  "category": "input",
  "description": "按已连接下游的任务目标规划公开检索，确认检索词后取材并保留来源。也支持手动检索词和指定网址。",
  "icon": "search",
  "enabled": true,
  "executor": "web",
  "inputs": [
    {
      "id": "materials",
      "name": "研究问题（可选）",
      "types": [
        "materials",
        "analysis",
        "documents"
      ],
      "multiple": true
    }
  ],
  "outputs": [
    {
      "id": "data",
      "name": "联网取材结果",
      "types": [
        "sources"
      ]
    }
  ],
  "fields": [
    {
      "key": "topic",
      "label": "公开研究主题（用于生成检索计划）",
      "type": "text",
      "default": ""
    },
    {
      "key": "queries",
      "label": "公开检索词（每行一条，最多3条）",
      "type": "textarea",
      "default": ""
    },
    {
      "key": "urls",
      "label": "指定公开网址（每行一条，最多4条）",
      "type": "textarea",
      "default": ""
    },
    {
      "key": "dynamic",
      "label": "读取动态网页（Mac桌面版）",
      "type": "boolean",
      "default": false
    },
    {
      "key": "clarify",
      "type": "boolean",
      "label": "关键歧义先询问（需要模型连接）",
      "default": true
    }
  ],
  "instructions": null,
  "requirements": [
    "至少一份相关输入"
  ],
  "implementation": "web",
  "origin": {
    "skill": "产品经理工作流 / 现有本地工具",
    "adaptedAt": "2026-10-18",
    "scope": "搜索并读取公开网页，保留来源和失败说明。"
  },
  "workflow": [
    {
      "id": "direction",
      "title": "明确下游工作方向",
      "prompt": "读取已连接下游的目标、大纲及材料要求；生成供用户确认的公开检索计划，确认后才运行检索。手动检索按用户明确填写的词执行。"
    },
    {
      "id": "clarify",
      "title": "确认关键范围歧义",
      "prompt": "搜索前检查产品形态、人群和地域等关键范围；取材后仅对真实来源引出的新分支询问。暂停保留来源和确认记录，不重复询问。只按用户看到并确认的检索词补充检索。"
    },
    {
      "id": "collect",
      "title": "采集或引用材料",
      "prompt": "按明确公开检索词搜索，或读取指定网页。可连接研究问题作为背景，保留来源与失败信息。"
    },
    {
      "id": "confirm",
      "title": "保留内容与来源",
      "prompt": "原样交接材料、来源和证据性质，不承担下游分析或报告整理。"
    }
  ],
  "capabilities": {
    "search": true,
    "generateDecisions": false
  },
  "contextPolicy": {
    "downstream": true
  }
}
