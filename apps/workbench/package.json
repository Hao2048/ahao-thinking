    "desktop:release": "node scripts/package-mac.mjs --release",
    "desktop:prepare": "node scripts/package-mac.mjs --runtime-only",
    "desktop:dev": "node scripts/start-desktop.mjs",
    "desktop:package": "node scripts/package-mac.mjs",
    "desktop:install": "node scripts/package-mac.mjs --install",
    "build:visuals": "node scripts/build-visuals.mjs",
    "test:nodes": "node --test tests/nodes.test.mjs",
    "test:nodes-ui": "node tests/node-browser.mjs",
    "test:nodes-desktop": "node tests/node-desktop.mjs",
    "test:node-outlines": "node tests/node-outline-browser.mjs",
    "test:node-theme": "node tests/node-theme-browser.mjs",
    "test:browser": "node tests/node-browser.mjs",
    "test:desktop": "node tests/node-desktop.mjs",
    "test:node-professional": "node tests/node-professional-browser.mjs",
    "audit:nodes": "node scripts/audit-node-capabilities.mjs"
  },
  "main": "desktop/main.mjs",
  "productName": "阿浩Thinking",
  "dependencies": {
    "cheerio": "1.2.0",
    "exceljs": "4.4.0",
    "jstat": "1.9.6",
    "mammoth": "1.13.0",
    "pdf-parse": "2.4.5",
    "undici": "8.11.2",
    "yauzl": "3.4.0"
